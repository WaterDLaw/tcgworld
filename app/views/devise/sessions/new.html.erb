<div class="max-w-md mx-auto my-12 p-8 bg-base-100 rounded-box border border-base-200 shadow-sm">
  <h2 class="text-2xl font-bold text-center mb-6">Log in</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-control w-full mb-4">
      <%= f.label :email, class: "label" do %>
        <span class="label-text font-semibold">Email</span>
      <% end %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
    </div>

    <div class="form-control w-full mb-4">
      <%= f.label :password, class: "label" do %>
        <span class="label-text font-semibold">Password</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="form-control mb-6">
        <label class="label cursor-pointer justify-start gap-3">
          <%= f.check_box :remember_me, class: "checkbox checkbox-primary checkbox-sm rounded" %>
          <span class="label-text">Remember me</span>
        </label>
      </div>
    <% end %>

    <div class="form-control mt-6">
      <%= f.submit "Log in", class: "btn btn-primary w-full" %>
    </div>
  <% end %>

  <div class="mt-6 border-t border-base-200 pt-4">
    <%= render "devise/shared/links" %>
  </div>
</div>
