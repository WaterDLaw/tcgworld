<footer class="footer bg-secondary text-secondary-content p-10 mt-12 grid-cols-1 md:grid-cols-4 gap-8">
  <aside class="flex flex-col gap-2">
    <span class="text-2xl font-black tracking-wider text-white">TCG WORLD</span>
    <p class="text-sm opacity-80 max-w-xs">
      Your ultimate destination for trading card games. Discover, collect, and trade the best cards from One Piece, Pokemon, Dragon Ball, Naruto, and more.
    </p>
    <p class="text-xs opacity-60 mt-4">
      &copy; <%= Time.current.year %> TCG World. All rights reserved.
    </p>
  </aside>
  
  <nav>
    <h6 class="footer-title opacity-100 font-bold text-white mb-3">Quick Links</h6>
    <%= link_to "Home", root_path, class: "link link-hover opacity-90 hover:opacity-100" %>
    <%= link_to "About Us", pages_about_path, class: "link link-hover opacity-90 hover:opacity-100" %>
    <%= link_to "Contact", pages_contact_path, class: "link link-hover opacity-90 hover:opacity-100" %>
  </nav>

  <nav>
    <h6 class="footer-title opacity-100 font-bold text-white mb-3">Trading Card Games</h6>
    <%= link_to "One Piece Card Game", "#", class: "link link-hover opacity-90 hover:opacity-100" %>
    <%= link_to "Pokemon TCG", "#", class: "link link-hover opacity-90 hover:opacity-100" %>
    <%= link_to "Dragon Ball Super", "#", class: "link link-hover opacity-90 hover:opacity-100" %>
    <%= link_to "Naruto TCG", "#", class: "link link-hover opacity-90 hover:opacity-100" %>
  </nav>

  <nav>
    <h6 class="footer-title opacity-100 font-bold text-white mb-3">My Account</h6>
    <% if user_signed_in? %>
      <%= link_to "Edit Profile", edit_user_registration_path, class: "link link-hover opacity-90 hover:opacity-100" %>
      <%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "link link-hover opacity-90 hover:opacity-100" %>
    <% else %>
      <%= link_to "Log In", new_user_session_path, class: "link link-hover opacity-90 hover:opacity-100" %>
      <%= link_to "Sign Up", new_user_registration_path, class: "link link-hover opacity-90 hover:opacity-100" %>
    <% end %>
  </nav>
</footer>
